# Maintainer: Bobby Coleman <bobbycoleman.dev@gmail.com>
#
# Binary package from the release tarball on downloads.omnipty.com
# (mirrored on the GitHub release). scripts/release-linux.sh bumps pkgver,
# the URL and the checksum after each release; regenerate .SRCINFO with
# `makepkg --printsrcinfo > .SRCINFO` before pushing to the AUR.
pkgname=omnipty-bin
pkgver=0.9.3
pkgrel=1
pkgdesc="A native, GPU-rendered terminal emulator with a vim-driven file tree drawer, splits and workspaces"
arch=('x86_64')
url="https://omnipty.com"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxcb' 'libxau' 'libxdmcp' 'libxkbcommon' 'libxkbcommon-x11'
         'wayland' 'vulkan-icd-loader' 'libnotify' 'hicolor-icon-theme')
optdepends=('vulkan-radeon: Vulkan driver for AMD GPUs'
            'vulkan-intel: Vulkan driver for Intel GPUs'
            'nvidia-utils: Vulkan driver for NVIDIA GPUs'
            'vulkan-swrast: software Vulkan, for machines with no GPU driver'
            'xdg-utils: open links in the browser')
provides=('omnipty')
# The package's name before the rename; pacman swaps it out for this one.
conflicts=('omnipty' 'oxide-terminal-bin')
replaces=('oxide-terminal-bin')
source=("https://downloads.omnipty.com/omnipty/${pkgver}/omnipty-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('3a2304f818a7a7116aa3cd49bf9bfe85cbe044e3155383f1daa342980739f7f3')

package() {
  cd "omnipty-${pkgver}-linux-x86_64"
  install -Dm755 omnipty "$pkgdir/usr/bin/omnipty"
  install -Dm644 omnipty.desktop "$pkgdir/usr/share/applications/omnipty.desktop"
  for png in icons/hicolor/*/apps/omnipty.png; do
    size="$(basename "$(dirname "$(dirname "$png")")")"
    install -Dm644 "$png" "$pkgdir/usr/share/icons/hicolor/$size/apps/omnipty.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
